{
  "name": "esp32-photoframe",
  "private": true,
  "description": "Workspace root for the PhotoFrame webapp and image-processing CLI",
  "license": "MIT",
  "workspaces": [
    "webapp",
    "process-cli"
  ],
  "scripts": {
    "build:webapp": "npm run build --workspace=webapp",
    "test": "npm run test --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "allowScripts": {
    "canvas@3.2.1": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "exifreader@4.41.3": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
