{
  "name": "esp32-photoframe-cli",
  "version": "1.0.0",
  "description": "CLI tool for processing images for ESP32 PhotoFrame - converts images to optimized BMP format with dithering",
  "type": "module",
  "bin": {
    "photoframe-process": "./cli.js"
  },
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:orientation": "cross-env NODE_OPTIONS=--experimental-vm-modules jest test/serve-orientation.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aitjcize/epaper-image-convert": "^0.1.18",
    "bonjour-service": "^1.4.3",
    "canvas": "3.2.1",
    "commander": "^11.1.0",
    "exif-parser": "^0.1.12",
    "form-data": "^4.0.0",
    "heic-convert": "^2.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "keywords": [
    "esp32",
    "photoframe",
    "image-processing",
    "dithering",
    "e-ink",
    "e-paper",
    "bmp",
    "image-conversion"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aitjcize/esp32-photoframe.git",
    "directory": "esp32-photoframe/process-cli"
  },
  "homepage": "https://github.com/aitjcize/esp32-photoframe#readme",
  "bugs": {
    "url": "https://github.com/aitjcize/esp32-photoframe/issues"
  },
  "author": "aitjcize",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "cli.js",
    "utils.js",
    "server.js",
    "staging/",
    "README.md"
  ]
}
